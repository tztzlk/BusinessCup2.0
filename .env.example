# Copy to .env for local runs. Never commit .env.
ANTHROPIC_API_KEY=
# 32 random bytes, base64: openssl rand -base64 32
MASTER_KEY=
DB_PATH=./data/paytrail.db
# Stripe test-mode secret key (sk_test_...). Live keys are refused unless ALLOW_LIVE_PAYMENTS=true.
STRIPE_SECRET_KEY=
# Optional: server-wide cap on Claude calls per hour (extract + explain). Default 300.
# CLAUDE_HOURLY_CAP=100
# Optional: rate limits per 10 minutes. Each household has its own budget; the per-IP ceiling is
# shared by everyone behind one address (a room of judges on one Wi-Fi). Defaults in lib/ratelimit.ts.
# RATE_EXTRACT_PER_VISITOR=15
# RATE_EXTRACT_PER_IP=80
# RATE_EXPLAIN_PER_VISITOR=40
# RATE_EXPLAIN_PER_IP=240
# RATE_HOUSEHOLD_PER_IP=120
